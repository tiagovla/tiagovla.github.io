---
const { page } = Astro.props
---

<div class="paginator">
    <a
        class:list={['previous', { hidden: !page.url.prev }]}
        href={page.url.prev || '#'}
        aria-hidden={!page.url.prev}
        tabindex={page.url.prev ? 0 : -1}
    >
        ←
    </a>

    {
        page.lastPage > 1 && (
            <span>
                {page.currentPage}/{page.lastPage}
            </span>
        )
    }

    <a
        class:list={['next', { hidden: !page.url.next }]}
        href={page.url.next || '#'}
        aria-hidden={!page.url.next}
        tabindex={page.url.next ? 0 : -1}
    >
        →
    </a>
</div>

<style>
    .paginator {
        font-size: 3em;
        text-align: center;
        padding-bottom: 0.5rem;
        padding-top: 0.5rem;
    }

    .hidden {
        visibility: hidden;
    }

    .paginator span {
        font-size: 0.5em;
    }

    .paginator a {
        text-decoration: none;
    }

    .paginator a.previous {
        float: left;
    }

    .paginator a.next {
        float: right;
    }

    .paginator a:visited {
        color: inherit;
    }
</style>
