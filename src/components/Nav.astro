---
import { Icon } from 'astro-icon/components'
import Link from './Link.astro'
import navData from '../data/navData'
---

<nav>
  <div class="navbar">
    <div class="navbar-small">
      <a href="/" class="navbar-brand" aria-label="Go home">
        AMORIM, T. V. L.
      </a>
      <button class="hamburger md:hidden" aria-label="Toggle navigation">
        <Icon class="hamburger-icon text-3xl" name="ic:round-menu" />
        <Icon class="hamburger-icon hidden text-3xl" name="ic:round-menu-open" />
      </button>
    </div>
    <div class="navbar-menu-container">
      <div class="navbar-menu">
        {
          navData.map((item) => (
            <Link
              text={item.name}
              href={item.path}
              style="primary"
              isFilled={false}
              data-navLink
              classes="navbar-item"
            />
          ))
        }
      </div>
    </div>
  </div>
</nav>

<style>
  .navbar {
    @apply bg-tokyodark-dark text-tokyodark-text px-10 py-3 flex justify-between items-center w-full;
    transition: background-color 0.3s ease-in-out;
  }

  .navbar-brand {
    @apply py-1 text-2xl font-semibold whitespace-nowrap hover:text-tokyodark-magenta transition duration-300;
    transition: transform 0.3s ease-in-out;
  }

  .navbar-small {
    @apply w-full flex flex-row items-center justify-between;
  }

  .navbar-menu-container {
    @apply flex items-center space-x-4 md:space-x-6;
  }

  .navbar-menu {
    @apply flex space-x-4 md:space-x-6 items-center;
  }

  .navbar-item {
    @apply text-tokyodark-comment hover:text-tokyodark-magenta transition duration-300 ease-in-out;
    transition:
      transform 0.2s ease,
      color 0.3s ease-in-out;
  }

  .navbar-item:hover {
    @apply text-tokyodark-magenta font-semibold;
    transform: scale(1.1); /* Scale on hover */
  }

  .navbar-item.active {
    @apply text-tokyodark-magenta font-semibold border-tokyodark-magenta;
  }

  .hamburger {
    @apply p-2 md:hidden text-tokyodark-text;
    background: none;
    border: none;
    cursor: pointer;
  }

  .navbar-menu {
    @apply hidden md:flex;
  }

  .navbar-menu.open {
    @apply flex;
  }

  .navbar.open {
    @apply flex-col;
  }

  @media (min-width: 768px) {
    .navbar.open {
      @apply flex-row;
    }
  }
</style>

<script>
  const navLinks = document.querySelectorAll('[data-navLink]')
  const hamburger = document.querySelector('.hamburger')
  const hamburgerIcons = document.querySelectorAll('.hamburger-icon')
  const navbarMenu = document.querySelector('.navbar-menu')
  const navbar = document.querySelector('.navbar')

  // Add active class to the current page link
  navLinks.forEach((link) => {
    if (link.getAttribute('href') === window.location.pathname) {
      link.classList.add('active')
    } else {
      link.classList.remove('active')
    }
  })

  hamburger.addEventListener('click', () => {
    hamburger.classList.toggle('open')
    navbarMenu.classList.toggle('open')
    navbar.classList.toggle('open')
    hamburgerIcons.forEach((icon) => icon.classList.toggle('hidden'))
  })

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768) {
      navbar.classList.remove('open')
      navbarMenu.classList.remove('open')
    }
  })
</script>
