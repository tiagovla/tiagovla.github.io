---
import { Icon } from 'astro-icon/components'
import navData from '../data/navData'
---

<header class="header">
    <a href="/" class="logo"> AMORIM, T. V. L. </a>
    <input type="checkbox" id="check" />
    <label for="check" class="icons">
        <Icon id="menu-icon" name="ic:round-menu" />
        <Icon id="close-icon" name="ic:round-close" />
    </label>
    <nav class="navbar">
        {navData.map((item) => <a href={item.path}> {item.name} </a>)}
    </nav>
</header>

<style>
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    padding: 1rem 10%;
    z-index: 100;
}

.header::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(50px);
    z-index: -1;
}

.icons {
    position: absolute;
    right: 5%;
    font-size: 2.8rem;
    cursor: pointer;
    display: none;
    transition: 0.3s ease;
    color: var(--tokyodark-text);
}

.icons:hover {
    color: var(--tokyodark-magenta);
}

.logo {
    font-size: 2rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    color: var(--tokyodark-text);
}

.logo:hover {
    color: var(--tokyodark-magenta);
}

.navbar {
    display: flex;
}

.navbar a {
    color: var(--tokyodark-text);
    font-size: 1.15rem;
    text-decoration: none;
    font-weight: 500;
    margin-left: 1.5rem;
    transition:
        transform 0.2s ease,
        color 0.3s ease-in-out;
}

.navbar a:hover {
    transform: scale(1.1);
    color: var(--tokyodark-magenta);
}

.navbar a.active {
    color: var(--tokyodark-magenta);
    border-color: var(--tokyodark-border);
    font-weight: 600;
}

#check {
    display: none;
}

@media (max-width: 992px) {
    .header {
        padding: 0.3rem 5%;
    }
}

@media (max-width: 883px) {
    .icons {
        display: inline-flex;
    }

    #check:checked ~ .icons #menu-icon {
        display: none;
    }

    .icons #close-icon {
        display: none;
    }

    #check:checked ~ .icons #close-icon {
        display: block;
    }

    .navbar {
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        height: 0;
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(50px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
        overflow: hidden;
        transition: 0.3s ease;
        display: flex;
        flex-direction: column;
    }

    #check:checked ~ .navbar {
        height: auto;
    }

    .navbar a {
        font-size: 1.1rem;
        margin: 0.5rem 0 0rem;
        text-align: center;
        transform: translateY(-50px);
        transition: 0.3s ease;
        opacity: 0;
    }

    .navbar a:nth-last-child(1) {
        margin-bottom: 1rem;
    }

    #check:checked ~ .navbar a {
        transform: translateY(0);
        opacity: 1;
    }

    #check:checked ~ .navbar a:hover {
        transform: scale(1.1);
    }
}
</style>

<script>
    const navLinks = document.querySelectorAll('.navbar a')
    navLinks.forEach((link) => {
        if (link.getAttribute('href') === window.location.pathname) {
            link.classList.add('active')
        } else {
            link.classList.remove('active')
        }
    })
</script>
