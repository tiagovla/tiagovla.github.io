---
const { date, title, description, url } = Astro.props
---

<div class="postcard">
    <time class="postcard-date" datetime={date.toISOString()}>
        {
            date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
            })
        }
    </time>
    <a class="post-title" href={url}>
        {title}
    </a>
    <p class="post-description">{description}</p>
</div>

<style>
    .postcard {
        padding: 0.7em 0em 0.7em 0em;
        transition: box-shadow 0.3s ease;
    }

    .postcard:hover {
        background-color: #dfdfdf;
    }

    .postcard-date {
        font-size: 0.9rem;
        color: #666;
        margin: 0 0 0 0;
        display: block;
    }

    .postcard .post-description {
        color: #444;
        margin: 0em 0 0em 0;
        padding: 0 0 0 0;
        line-height: 1.5;
    }

    .post-title {
        display: block;
        margin-top: 0.5em;
        margin-bottom: 0.2rem;
        color: black;
    }

    .post-title:visited {
        color: black;
    }
</style>
