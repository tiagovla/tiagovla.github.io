---
import MainLayout from '../../layouts/MainLayout.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
    const posts = await getCollection('posts')
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }))
}

const { post } = Astro.props
const tags = post.data.tags.map((tag) => tag.trim())
const { Content } = await render(post)
---

<MainLayout>
    <h1 class="post-heading">{post.data.title}</h1>
    <p class="post-meta">
        {post.data.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
        })}
        {tags.length > 0 ? (
            <>
                {' in '}
                {tags.map((tag, i) => {
                    const href = `/tags/${tag}/1`
                    const separator =
                        i === 0 ? '' : i === tags.length - 1 ? ' and ' : ', '

                    return (
                        <>
                            {separator}
                            <a class="tag-link" href={href}>
                                {tag}
                            </a>
                            {i === tags.length - 1 ? '.' : ''}
                        </>
                    )
                })}
            </>
        ) : (
            '.'
        )}
    </p>

    <article class="post-content">
        <Content />
    </article>
</MainLayout>

<style>
    :global(html:not(.dark) .post-content .post-emoji) {
        display: inline-block;
        filter: grayscale(1);
    }

    .post-heading {
        color: var(--heading);
        font-size: clamp(1.875rem, 4vw, 2.125rem);
        line-height: 1.3;
    }
</style>

<script>
    import { grayscaleEmojis } from '../../utils/grayscaleEmojis'

    grayscaleEmojis(document.querySelector('.post-content'))

    const copyIcon =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="13" height="13" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></svg>'
    const copiedIcon =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>'

    document.querySelectorAll('pre').forEach((block) => {
        const button = document.createElement('button')
        button.className = 'copy-code-button'
        button.type = 'button'
        button.setAttribute('aria-label', 'Copy code')
        button.title = 'Copy code'
        button.innerHTML = copyIcon
        block.classList.add('has-copy-button')
        block.append(button)

        button.addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(
                    block.querySelector('code')?.textContent ?? '',
                )
                button.innerHTML = copiedIcon
                button.setAttribute('aria-label', 'Copied')
                button.title = 'Copied'
            } catch {
                button.setAttribute('aria-label', 'Unable to copy code')
                button.title = 'Unable to copy code'
            }

            window.setTimeout(() => {
                button.innerHTML = copyIcon
                button.setAttribute('aria-label', 'Copy code')
                button.title = 'Copy code'
            }, 1500)
        })
    })
</script>
