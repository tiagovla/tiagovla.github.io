---
import MainLayout from '../layouts/MainLayout.astro'
const pdfUrl = 'https://tiagovla.github.io/cv/resume.pdf'
---

<MainLayout>
    <div style="width: 100%; height: 80vh;">
        <iframe
            src={pdfUrl}
            width="100%"
            height="100%"
            style="border: none;"
            title="PDF Form"></iframe>
    </div>
    <span class="created_with"
        >Created using <a href={'https://github.com/tiagovla/cv'}
            >github.com/tiagovla/cv</a
        >.</span
    >
</MainLayout>

<style>
    .created_with {
        display: block;
        text-align: center;
        margin-top: 20px;
        font-size: 0.8em;
    }
</style>
