---
import { getCollection } from 'astro:content'
const projects = await getCollection('projects')
const publications = (await getCollection('publications')).sort(
    (a, b) => b.data.year - a.data.year,
)
import MainLayout from '../layouts/MainLayout.astro'
---

<MainLayout>
    <article>
        <p>
            I'm tiagovla, a developer and Electrical Engineering PhD passionate
            about open source software.
        </p>

        <p>
            I work at the intersection of academic research and open source
            development, focusing on high-performance simulation, developer
            tooling, and web publishing infrastructure. I'm particularly
            interested in connecting scientific computing with accessible, open
            workflows.
        </p>

        <p>
            I started programming by automating tasks in Linux and writing tools
            to support my research. These days, I work mostly with Python, C++,
            Javascript, and Go—along with Lua and Shell for system scripting and
            Neovim customization.
        </p>

        <p>
            To get in touch, you can find me at @tiagovla on{' '}
            <a href="https://github.com/tiagovla/">github.com</a>.
        </p>
    </article>

    <h2 class="custom-title">Projects:</h2>
    <ul class="project-container" role="list">
        {projects.map((item) => (
            <li class="project-item">
                <a class="project-link" href={item.data.url}>
                    {item.data.name}
                </a>
                <p class="project-description">{item.data.description}</p>
            </li>
        ))}
    </ul>
    <h2 class="custom-title">Publications:</h2>
    <ul class="publication-container" role="list">
        {publications.map((item) => (
            <li>
                <cite>{item.data.title}</cite>
                <p class="publication-details">
                    {item.data.authors}
                    <br />
                    {item.data.venue}
                </p>
            </li>
        ))}
    </ul>
</MainLayout>

<style>
    .project-container,
    .publication-container {
        list-style: none;
        margin: 0;
        padding: 0.5rem 0 0;
        line-height: 2;
    }
    .project-item {
        transition: box-shadow 0.3s ease;
    }
    .project-description,
    .publication-details {
        margin: 0.2em 0em 0.5em 0em;
        padding: 0 0 0 0;
    }
</style>
