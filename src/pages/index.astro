---
import MainLayout from '../layouts/MainLayout.astro'
---

<MainLayout>
    <main>
        <section class="welcome">
            <h1>Welcome!</h1>
            <p>
                Hi, I’m Tiago 👋! Engineer, number-crunching nerd, and tech
                tinkerer. I dig solving problems and sharing cool stuff—check it
                out! 🚀
            </p>
        </section>
    </main>
</MainLayout>

<style>
    main {
        @apply h-full flex flex-col justify-center items-center;
    }
    .welcome {
        @apply flex flex-col p-10 mx-auto;
        animation: fadeInUp 1s ease-out;
    }

    .welcome h1 {
        @apply p-1 text-4xl font-semibold text-tokyodark-blue;
        opacity: 0;
        animation: fadeInUp 1s ease-out 0.3s forwards;
    }

    .welcome p {
        @apply p-1 text-2xl text-tokyodark-text;
        opacity: 0;
        animation: fadeInUp 1s ease-out 1s forwards; /* Increased delay to 1s */
    }

    @keyframes fadeInUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
