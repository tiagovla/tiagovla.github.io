---
import MainHead from '../layouts/MainHead.astro'
import Footer from '../components/Footer.astro'
import Nav from '../components/Nav.astro'
import '../styles/global.css'
const { title } = Astro.props
---

<!doctype html>
<html lang="en">
  <MainHead {title} />
  <slot name="posthead" />
  <body>
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
